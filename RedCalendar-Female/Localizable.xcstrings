    "Profile.AutoConfirm.Footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a new period is marked as started while the previous one was never ended, it will be confirmed automatically, with a length of %@."
