    "DeleteAccount.Grace.Footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account is marked for deletion right away, and the data is erased for good after %@. Sign in before then and everything comes back."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт помечается на удаление сразу, а данные стираются окончательно через %@. Если войти в аккаунт до этого срока — всё вернётся как было."
          }
        }
      }
    },
    "DeleteAccount.Message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete every cycle, comment and tag attached to the account."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит всю историю циклов, комментарии и теги, привязанные к аккаунту."
          }
        }
      }
    },
